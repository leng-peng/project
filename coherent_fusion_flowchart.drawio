<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="空海信号级相参融合" id="coherent_fusion">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1"
                  page="1" pageScale="1" pageWidth="1169" pageHeight="827"
                  math="0" shadow="1">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- ===== Title ===== -->
        <mxCell id="title" value="空海条件下信号级相参融合方案流程图"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;
                 verticalAlign=middle;whiteSpace=wrap;rounded=0;
                 fontSize=18;fontStyle=1;fontColor=#1F3864;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="760" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 1: 系统构型 ===== -->
        <mxCell id="r1" value="&lt;b&gt;① 系统构型 / 阵列布局&lt;/b&gt;&lt;br/&gt;2发射机(海面舰载) + 3接收机(机载) → 共6条独立双基地链路"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E75B6;fontColor=#ffffff;
                 strokeColor=#1F4E79;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 2: OFDM ===== -->
        <mxCell id="r2" value="&lt;b&gt;② OFDM 频分复用&lt;/b&gt;&lt;br/&gt;奇子载波→发射机1 &amp;nbsp; 偶子载波→发射机2 &amp;nbsp; (同频干扰为零)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E75B6;fontColor=#ffffff;
                 strokeColor=#1F4E79;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 3: RD ===== -->
        <mxCell id="r3" value="&lt;b&gt;③ 各接收节点: 距离-多普勒(RD)匹配滤波&lt;/b&gt;&lt;br/&gt;输出: 6条链路 × 复数 RD 矩阵 (幅度 + 相位)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;fontColor=#ffffff;
                 strokeColor=#375623;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="230" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 4: SIC1 ===== -->
        <mxCell id="r4" value="&lt;b&gt;④ 第一轮 SIC 检测 (强目标)&lt;/b&gt;&lt;br/&gt;无 MTI · 高门限 → 检测出强散射 / 大 RCS 目标"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;fontColor=#ffffff;
                 strokeColor=#843C10;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="310" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 5: 重建消除 ===== -->
        <mxCell id="r5" value="&lt;b&gt;⑤ 强目标回波重建 &amp; 顺序干扰消除 (SIC)&lt;/b&gt;&lt;br/&gt;从各链路合成信号中逐一减去强目标贡献"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;fontColor=#ffffff;
                 strokeColor=#843C10;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="390" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 6: 残差 ===== -->
        <mxCell id="r6" value="&lt;b&gt;⑥ 残差信号&lt;/b&gt;&lt;br/&gt;(强目标分量已消除，弱小/隐身目标暴露)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;fontColor=#ffffff;
                 strokeColor=#375623;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="470" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 7: MTI ===== -->
        <mxCell id="r7" value="&lt;b&gt;⑦ 多通道 MTI 滤波&lt;/b&gt;&lt;br/&gt;慢速通道 | 中速通道 | 快速通道 (覆盖全速域)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;fontColor=#ffffff;
                 strokeColor=#375623;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="550" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 8: SIC2 ===== -->
        <mxCell id="r8" value="&lt;b&gt;⑧ 第二轮 SIC 检测 (弱小/隐身目标)&lt;/b&gt;&lt;br/&gt;低门限 · MTI 增强 → 检出低 RCS 慢速目标"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;fontColor=#ffffff;
                 strokeColor=#843C10;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="630" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 9: RANSAC ===== -->
        <mxCell id="r9" value="&lt;b&gt;⑨ RANSAC-GN 精化解算&lt;/b&gt;&lt;br/&gt;多链路量测 → 3D 位置 &amp; 速度估计"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;fontColor=#ffffff;
                 strokeColor=#375623;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="710" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 10: Kalman ===== -->
        <mxCell id="r10" value="&lt;b&gt;⑩ 3槽 Kalman 跟踪器&lt;/b&gt;&lt;br/&gt;输出: 目标航迹 (精确位置估计) → 反馈至相参融合环"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C00000;fontColor=#ffffff;
                 strokeColor=#900000;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="790" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 11: Phase ===== -->
        <mxCell id="r11" value="&lt;b&gt;⑪ 双基地时延 τ_l 计算 &amp; 相位补偿因子&lt;/b&gt;&lt;br/&gt;exp(−j·2π·f_c·τ_l) &amp;nbsp; (由跟踪位置驱动)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7030A0;fontColor=#ffffff;
                 strokeColor=#4C1F70;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="890" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 12: Align ===== -->
        <mxCell id="r12" value="&lt;b&gt;⑫ 各链路复数回波相位对准 → 矢量叠加&lt;/b&gt;&lt;br/&gt;理论相参增益上限: 10·lg(6) ≈ 7.8 dB"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7030A0;fontColor=#ffffff;
                 strokeColor=#4C1F70;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="970" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 13: ph_cons (Diamond) ===== -->
        <mxCell id="r13" value="&lt;b&gt;⑬ ph_cons 相位一致性检验&lt;/b&gt;&lt;br/&gt;链路相位斜率 vs 跟踪预测多普勒&lt;br/&gt;|偏差| &gt; 阈值 → 降权 / 剔除受扰链路"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#7030A0;fontColor=#ffffff;
                 strokeColor=#4C1F70;fontSize=10;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="200" y="1050" width="560" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 14: Gcoh ===== -->
        <mxCell id="r14" value="&lt;b&gt;⑭ 相参增益 G_coh 实时监测 &amp; 自适应加权&lt;/b&gt;&lt;br/&gt;海面起伏相位误差抑制 (舰载平台竖向起伏 ~0.8 m)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7030A0;fontColor=#ffffff;
                 strokeColor=#4C1F70;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="1160" width="760" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== ROW 15: Output ===== -->
        <mxCell id="r15" value="&lt;b&gt;⑮ 融合输出&lt;/b&gt;&lt;br/&gt;① 相参叠加检测结果 (信噪比提升 ~7.8 dB)&lt;br/&gt;② 目标 3D 航迹 (位置 + 速度)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0070C0;fontColor=#ffffff;
                 strokeColor=#00478F;fontSize=11;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="1250" width="760" height="65" as="geometry"/>
        </mxCell>

        <!-- ===== Arrows: main flow ===== -->
        <mxCell id="a1"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r1"  target="r2"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r2"  target="r3"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r3"  target="r4"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r4"  target="r5"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r5"  target="r6"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r6"  target="r7"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r7"  target="r8"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r8"  target="r9"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r9"  target="r10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r10" target="r11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r11" target="r12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r12" target="r13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r13" target="r14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r14" target="r15" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== Feedback arrow: Kalman → RD (right side loop) ===== -->
        <mxCell id="fb1"
          value="跟踪反馈&#xa;(相位补偿闭环)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;
                 entryX=1;entryY=0.5;entryDx=0;entryDy=0;
                 strokeColor=#C00000;strokeWidth=2;fontColor=#C00000;fontStyle=1;fontSize=9;
                 endArrow=block;endFill=1;"
          edge="1" source="r10" target="r3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="920" y="817"/>
              <mxPoint x="920" y="257"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
